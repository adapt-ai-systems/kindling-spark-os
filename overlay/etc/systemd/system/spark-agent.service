# The spark agent (agent/ in kindling-spark-os): node status page and MCP tools on :8090,
# registered with the local mentatd as group agent-<hostname>.
#
# It observes and never changes the host, except one file: the GPU clock cap under
# /etc/spark/gpucap, which the root unit sparkos-gpucap applies. CAP_SYS_PTRACE is the one capability it holds, so py-spy
# can read an engine's Python stacks in any container. Everything it cannot read directly comes from
# the files spark-log-snapshot.sh writes under /var/log/spark.
#
# It needs no settings: it reads the cluster from the local mentatd and lets in loopback and this
# box's own subnets. /etc/spark/agent.env, which the initramfs copies from the box's own disk, can
# set MENTAT_ROUTER_URL (linked from the page, and always let in) and ALLOWED_SOURCES
# (comma-separated CIDR blocks or address prefixes, in place of the subnets).
[Unit]
Description=Spark host agent
After=network-online.target mentatd.service
Wants=network-online.target

[Service]
User=spark-agent
EnvironmentFile=-/etc/spark/agent.env
Environment=AGENT_LOG_DIR=/var/log/spark
Environment=PYTHONPATH=/opt/spark-agent/lib
Environment=PY_SPY=/opt/spark-agent/lib/bin/py-spy
Environment=SPARK_MEMORY_PY=/usr/local/bin/spark-memory.py
# /etc/spark is copied from the DGX OS disk at boot and comes back owned by root; the agent
# must still be able to write the cap, so the directory is handed to it before it starts.
ExecStartPre=+/usr/bin/install -d -o spark-agent -g spark-agent -m 755 /etc/spark/gpucap
ExecStart=/usr/bin/python3 /opt/spark-agent/spark-agent.py --port 8090
Restart=always
RestartSec=5

AmbientCapabilities=CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
# The one thing it writes: the GPU clock cap for sparkos-gpucap (see /power).
ReadWritePaths=/etc/spark/gpucap
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
